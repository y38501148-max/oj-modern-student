{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["chrome"],
    "strict": true, "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.js", "src/**/*.mjs"]
}
