{
  "manifest_version": 3,
  "name": "OJ Modern Student",
  "version": "0.2.7",
  "description": "北航 Accoding 学生端：界面美化、文本与代码复制、提交界面优化。",
  "homepage_url": "https://github.com/y38501148-max/oj-modern-student",
  "permissions": [
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "检查更新 · OJ Modern Student",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://accoding.buaa.edu.cn/problem/*",
        "https://accoding.buaa.edu.cn/contest-ng/*"
      ],
      "js": [
        "math-config.js",
        "mathjax-svg.js",
        "math-layout.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://accoding.buaa.edu.cn/*"
      ],
      "css": [
        "theme.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
